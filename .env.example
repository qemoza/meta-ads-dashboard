# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git ignored. Keys go here and nowhere else. Never paste one into a page or a chat.

# Step 1. Your Meta key (Business settings, System users, a token with ads_read)
META_ACCESS_TOKEN=
# Your ad account number from Ads Manager. With or without act_ in front.
META_AD_ACCOUNT_ID=

# Step 4. Your calendar. Fill in the one you use and leave the other blank.
# Cal.com: Settings, Developer, API keys
CAL_API_KEY=
# Calendly: Integrations and apps, API and webhooks, Personal access tokens
CALENDLY_TOKEN=
# Only count these event types as sales calls. Cal.com event slug or Calendly event name,
# comma separated. Leave blank to count every booking.
SALES_EVENTS=

# Optional settings. Remove the # to use one.
# ask: you mark untagged bookings by hand on the page. not_ads: an untagged booking is not from the ads.
# UNTAGGED_BOOKINGS=ask
# utm_source values that count as your Meta ads.
# AD_SOURCES=facebook,fb,meta,instagram,ig
# How many days back to pull.
# DAYS=30
# Which page design to open: clean, ledger or night.
# DESIGN=clean
# PORT=8787
# META_API_VERSION=v26.0
# Only change these on a server. The script refuses a public HOST without a password.
# HOST=127.0.0.1
# DASH_PASSWORD=
